                TIMECON 100.0 
            &END NOSE
        &END THERMOSTAT
        &PRINT 
            &ENERGY
                &EACH
                    MD 400
                &END
            &END ENERGY
            &PROGRAM_RUN_INFO
                &EACH
                    MD 100000
                &END
            &END PROGRAM_RUN_INFO
        &END PRINT
    &END MD
    &PRINT 
        &TRAJECTORY  SILENT
          FORMAT DCD
            &EACH
                MD 400
            &END EACH
        &END TRAJECTORY
        &RESTART SILENT
            &EACH 
                MD 100000
            &END EACH
        &END RESTART
        &VELOCITIES OFF
        &END VELOCITIES
        &FORCES OFF
        &END FORCES
        &RESTART_HISTORY OFF
        &END RESTART_HISTORY 
    &END PRINT
&END MOTION
