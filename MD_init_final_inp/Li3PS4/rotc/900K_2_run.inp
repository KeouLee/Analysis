    &MD
        ENSEMBLE NVT
        TIMESTEP 2.0
        STEPS  25005000 #1.1ns
        TEMPERATURE 900
        &THERMOSTAT
            &NOSE
                LENGTH 3
                ! fs
                TIMECON 100.0 
            &END NOSE
        &END THERMOSTAT
        &PRINT 
            &ENERGY
                &EACH
                    MD 200
                &END
            &END ENERGY
            &PROGRAM_RUN_INFO
                &EACH
                    MD 100000
                &END
            &END PROGRAM_RUN_INFO
        &END PRINT
    &END MD
    &PRINT 
        &TRAJECTORY  SILENT
            FORMAT DCD
            &EACH
                MD 100
            &END EACH
        &END TRAJECTORY
        &RESTART SILENT
            &EACH
                MD 100000
            &END EACH
        &END RESTART
        &VELOCITIES OFF
        &END VELOCITIES
        &FORCES OFF
        &END FORCES
        &RESTART_HISTORY OFF
        &END RESTART_HISTORY 
    &END PRINT
&END MOTION
