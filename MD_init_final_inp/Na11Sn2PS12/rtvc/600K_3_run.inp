&END FORCE_EVAL
&MOTION
    &CONSTRAINT
        &FIXED_ATOMS
        COMPONENTS_TO_FIX   XYZ
        MOLNAME  M0  M1  M2  M3  M4  M5  M6  M7  M8  M9  M10  M11  M12  M13  M14  M15  M16  M17  M18  M19  M20  M21  M22  M23  M24  M25  M26  M27  M28  M29  M30  M31  
        &END FIXED_ATOMS
    &END CONSTRAINT
    &MD
        ENSEMBLE NVT
        TIMESTEP 2.0
        STEPS  25010000 ! 1.1ns
        TEMPERATURE 600
        &THERMOSTAT
            &NOSE
                LENGTH 3
                ! fs
                TIMECON 100.0 
            &END NOSE
        &END THERMOSTAT
        &PRINT 
            &ENERGY
                &EACH
                    MD 200
                &END
            &END ENERGY
            &PROGRAM_RUN_INFO
                &EACH
                    MD 10000
                &END
            &END PROGRAM_RUN_INFO
        &END PRINT
    &END MD
    &PRINT 
        &TRAJECTORY  SILENT
          FORMAT DCD
            &EACH
                MD 100
            &END EACH
        &END TRAJECTORY
        &RESTART SILENT
            &EACH 
                MD 100000
            &END EACH
        &END RESTART
        &VELOCITIES OFF
        &END VELOCITIES
        &FORCES OFF
        &END FORCES
        &RESTART_HISTORY OFF
        &END RESTART_HISTORY 
    &END PRINT
&END MOTION
