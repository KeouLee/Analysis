&MOTION
    !&CONSTRAINT
    !    CONSTRAINT_INIT T
    !    &rotc
    !        MOLNAME M0
    !        ATOMS 1 2 3 4 5
    !        POSITIONS0 [angstrom] 5.4513900000 4.3269700000 3.5664500000 4.0585900000 4.9453900000 4.5274400000 5.6173700000 5.7721300000 4.6488800000 5.4695700000 4.1304600000 5.3741500000 5.1628400000 4.7731400000 4.5439000000 
    !    &end rotc
    !&END CONSTRAINT
    &MD
        ENSEMBLE NVT
        TIMESTEP 0.5
        STEPS  100000000
        TEMPERATURE 600
        &THERMOSTAT
            &NOSE
                LENGTH 3
                ! fs
                TIMECON 100.0 
            &END NOSE
        &END THERMOSTAT
        &PRINT 
            &ENERGY
                &EACH
                    MD 800
                &END
            &END ENERGY
            &PROGRAM_RUN_INFO
                &EACH
                    MD 100000
                &END
            &END PROGRAM_RUN_INFO
        &END PRINT
    &END MD
    &PRINT 
        &TRAJECTORY  SILENT
          FORMAT DCD
            &EACH
                MD 400
            &END EACH
        &END TRAJECTORY
        &RESTART SILENT
            &EACH 
                MD 100000
            &END EACH
        &END RESTART
        &VELOCITIES OFF
        &END VELOCITIES
        &FORCES OFF
        &END FORCES
        &RESTART_HISTORY OFF
        &END RESTART_HISTORY 
    &END PRINT
&END MOTION
